# ============================================
# RAG Company Assistant — Environment Variables
# ============================================

# LLM (Ollama)
OLLAMA_URL=http://localhost:11434
LLM_MODEL=llama3
LLM_TEMPERATURE=0.1

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Qdrant (local file mode — no server needed)
QDRANT_PATH=./data/qdrant_storage
QDRANT_COLLECTION=company_docs

# Retrieval
TOP_K_DENSE=20
TOP_K_SPARSE=20
TOP_K_FINAL=5

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Auth
SECRET_KEY=change-this-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend (Vite exposes only VITE_* variables)
VITE_GOOGLE_CLIENT_ID=

# Server
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Platform API (/v1) — see docs/ARCHITECTURE.md
VECTOR_BACKEND=qdrant             # pgvector for the api + worker setup (docker-compose sets it)
PGVECTOR_URL=                     # empty = DATABASE_URL without +asyncpg
REDIS_URL=                        # required for /v1 (queue + rate limit)
TENANT_API_KEYS=demo:demo-key     # tenant:key,tenant:key
RATE_LIMIT_PER_MINUTE=120
MAX_UPLOAD_MB=20
PLATFORM_LLM_PROVIDER=ollama      # stub = no model (tests, load tests)
PLATFORM_LLM_MODEL=llama3.2:3b
PLATFORM_LLM_API_KEY=
PLATFORM_LLM_BASE_URL=
LOG_FORMAT=text                   # json for structured logs
# Optional Langfuse tracing of /v1/query (pip install langfuse)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
